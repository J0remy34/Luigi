MYSQSL_HOST="url de tu base de datos o ip del servidor"
MYSQSL_PORT="puerto de tu base de datos de mysql en el servidor"
MYSQSL_USER="usuario de tu base de datos"
MYSQSL_PASSWORD="contraseña de tu base de datos"
MYSQSL_DATABASE="nombre de tu base de datos"

DEBUG=True
SECRET_KEY="tu clave secreta de django"
USER_PYMYSQL=True